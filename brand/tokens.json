{
  "$description": "Design tokens de Matou (@matou.ai). Source unique : le moteur vidéo et la page de visualisation lisent ce fichier.",
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "safeZone": {
    "$description": "Marges où l'interface de TikTok, Reels et Shorts recouvre la vidéo. Rien d'important dehors.",
    "top": 220,
    "bottom": 420,
    "left": 72,
    "right": 150
  },
  "colors": {
    "papier": "#FBF5E6",
    "carreau": "#C9D9EC",
    "marge": "#EE9A9A",
    "encre": "#1C1B1A",
    "graphite": "#A9A6A0",
    "blanc": "#FFFFFF",
    "surligneur": "#FFE14A",
    "main": "#FFD21F",
    "mainContour": "#C98A00",
    "stylo": {
      "bleu": "#2457C5",
      "vert": "#1F8A4C",
      "rouge": "#D33A2C"
    },
    "fluo": {
      "jaune": "#FFE14A",
      "rose": "#FF9EC4",
      "vert": "#9EEA8C",
      "bleu": "#8FD3FF",
      "orange": "#FFB65C"
    }
  },
  "statut": {
    "$description": "Toujours dire si l'info est annoncée, disponible ou une rumeur. Chaque statut a sa couleur de stylo.",
    "annonce": { "label": "ANNONCÉ", "couleur": "#2457C5" },
    "disponible": { "label": "DISPONIBLE", "couleur": "#1F8A4C" },
    "rumeur": { "label": "RUMEUR", "couleur": "#D33A2C" }
  },
  "hypeMetre": {
    "buzz": { "label": "Pur buzz", "icone": "bulle", "fluo": "#FF9EC4" },
    "prometteur": { "label": "Prometteur", "icone": "pousse", "fluo": "#9EEA8C" },
    "gameChanger": { "label": "Game changer", "icone": "fusee", "fluo": "#FFB65C" }
  },
  "typo": {
    "titre": { "famille": "Permanent Marker", "fichier": "brand/fonts/PermanentMarker.woff2", "usage": "Hooks, titres, chiffres clés, verdict" },
    "texte": { "famille": "Shantell Sans", "fichier": "brand/fonts/ShantellSans.woff2", "usage": "Sous-titres, cartes, sources", "axes": { "wght": 700, "INFM": 60, "BNCE": 0 } },
    "tailles": {
      "hook": 112,
      "titre": 88,
      "chiffre": 220,
      "carte": 60,
      "sousTitre": 68,
      "source": 34,
      "etiquette": 30
    }
  },
  "trait": {
    "$description": "Le feutre noir : un trait épais et rond qui « bouillonne » (contour redessiné ~10 fois par seconde).",
    "epaisseur": 10,
    "epaisseurFine": 6,
    "bouillonnementFps": 10,
    "bouillonnementAmplitude": 3.5
  },
  "grille": {
    "carreau": 48,
    "margeX": 108
  },
  "mouvement": {
    "$description": "Durées en images (30 i/s). Entrées rapides et sèches, jamais de fondu lent.",
    "entree": 8,
    "sortie": 6,
    "surlignage": 10,
    "ressort": { "damping": 14, "stiffness": 180, "mass": 0.6 }
  },
  "audio": {
    "voixDb": 0,
    "musiqueVolume": 0.07,
    "bruitagesVolume": 0.35
  }
}
