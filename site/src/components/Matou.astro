---
// Matou en SVG inline (aucune requête en plus), tiré de brand/mascotte/.
const dessins = import.meta.glob<string>('../../../brand/mascotte/*.svg', {eager: true, query: '?raw', import: 'default'});

type Props = {expression?: string; class?: string; decoratif?: boolean};
const {expression = 'content', class: classe, decoratif = false} = Astro.props;
const brut = dessins[`../../../brand/mascotte/matou-${expression}.svg`];
if (!brut) throw new Error(`Matou : expression inconnue « ${expression} »`);
const svg = brut
  .replace(/<\?xml[^>]*\?>\s*/, '')
  .replace(/<svg([^>]*?)\swidth="\d+"\sheight="\d+"/, '<svg$1')
  .replace('<svg', decoratif ? '<svg aria-hidden="true" focusable="false"' : '<svg role="img" aria-label="Matou, le chat à lunettes"');
---

<span class:list={['matou', classe]} set:html={svg} />

<style>
  .matou {
    display: block;
  }
  .matou :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
