---
import {RESEAUX} from '../config';

type Props = {grand?: boolean; source?: string};
const {grand = false, source} = Astro.props;
---

<ul class:list={['reseaux', {grand}]}>
  {
    RESEAUX.map((r) => (
      <li>
        <a href={r.url} rel="me noopener" target="_blank" data-reseau={r.id} data-source={source}>
          <span class="nom">{r.nom}</span>
          {grand && <span class="pseudo">{r.pseudo}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .reseaux {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grand {
    flex-direction: column;
  }
  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 1.1rem;
    background: var(--blanc);
    border: 3px solid var(--encre);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    box-shadow: 3px 3px 0 var(--encre);
    color: var(--encre);
    font-family: var(--font-main);
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .grand a {
    padding: 0.9rem 1.4rem;
    font-size: 1.15rem;
  }
  a:hover,
  a:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--encre);
    background: var(--surligneur);
  }
  .pseudo {
    font-weight: 400;
    opacity: 0.7;
  }
</style>
