---
import tokens from '../../../brand/tokens.json';
import type {Statut} from '../lib/episodes';

type Props = {statut: Statut};
const {label, couleur} = tokens.statut[Astro.props.statut];
---

<span class="tampon" style={`--c: ${couleur}`}>{label}</span>

<style>
  .tampon {
    display: inline-block;
    padding: 0.15em 0.6em;
    border: 3px solid var(--c);
    border-radius: 6px;
    color: var(--c);
    font-family: var(--font-titre);
    font-size: 1rem;
    letter-spacing: 0.04em;
    transform: rotate(-4deg);
    mix-blend-mode: multiply;
  }
</style>
